# Production configuration for the API.
#
#   cp .env.production.example .env.production
#
# Then fill in every value marked CHANGE ME. `validateEnv` runs at bootstrap and
# throws on the first problem, so a mistake here fails the container immediately
# rather than at the first request that needs the value — read the logs.
#
# This file is gitignored (`.env.*.local` is not enough — see DEPLOY.md).

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api
DEFAULT_LOCALE=lo
# `debug` logs every request body; keep it at info in production.
LOG_LEVEL=info

# Host port the API is published on. 3000 by default; set to 80 to serve it
# directly, or leave it and put a reverse proxy in front later.
API_PUBLIC_PORT=3000

# ── MongoDB ─────────────────────────────────────────────────────────────────
# The Atlas cluster the school already uses. Nothing to migrate: this stack runs
# no database of its own.
#
# Atlas blocks by IP — add the EC2 instance's public IP under
# Network Access → IP Access List, or the API will hang and then fail readiness.
MONGODB_URI=CHANGE_ME_mongodb+srv://user:password@cluster0.example.mongodb.net/vpsi-school?retryWrites=true&w=majority

# ── Redis ───────────────────────────────────────────────────────────────────
# REDIS_HOST/REDIS_PORT are set by docker-compose.prod.yml and ignored here.
# This password is applied to the Redis container *and* handed to the API, so
# changing it means recreating the redis service.
#   generate with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME
CACHE_TTL_SECONDS=300

# ── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters each, and the two must differ — a refresh token that
# verifies against the access secret is an access token that never expires.
#   generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_THE_ABOVE
JWT_REFRESH_TTL=7d

PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── Object storage ──────────────────────────────────────────────────────────
# Student photos, lesson-plan documents and generated PDFs.
#
# The API mints short-lived *signed* URLs, and an S3 signature covers the Host
# header — so the browser must open the object at exactly the host in
# S3_ENDPOINT. Real S3 satisfies that for free, which is why it is the default
# here rather than a MinIO container on this box: from inside the instance,
# a container cannot reach the instance's own public IP (AWS does not hairpin
# it), so a self-hosted MinIO needs a real domain name to work at all.
#
# Create the bucket first — see DEPLOY.md.
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Real S3 uses virtual-hosted-style addressing; only MinIO needs path style.
S3_FORCE_PATH_STYLE=false
# Declared by the config schema but never read — signed URLs carry S3_ENDPOINT's
# host. Kept in step with it so it does not mislead whoever edits this next.
S3_PUBLIC_URL=https://s3.ap-southeast-1.amazonaws.com
S3_SIGNED_URL_TTL_SECONDS=900

# The API starts and serves every non-file route even when the bucket is
# unreachable — StorageService warns rather than throws. So an unfinished S3
# setup shows up as failing uploads, not a dead deployment.

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins; never a wildcard. An origin here is scheme +
# host + port with no trailing slash.
#
# Every origin the admin is served from needs its own entry — a developer machine
# running `npm run dev`, the deployed site, and later any CDN domain in front of
# it. A missing entry is not an API error: the request reaches the API and
# succeeds, the response simply arrives without the `Access-Control-Allow-Origin`
# header and the browser discards it. In devtools that looks like a failed
# request showing "Provisional headers are shown" and no response at all.
#
# Changing this needs the container recreated, not restarted — compose reads the
# env file when it builds the container:
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#     up -d --no-build --force-recreate api
CORS_ORIGINS=http://localhost:5173,http://vpsi-admin.s3-website-ap-southeast-1.amazonaws.com

# ── Rate limiting ───────────────────────────────────────────────────────────
# Applies per client IP. The API sets `trust proxy`, so behind a load balancer
# this counts the real client rather than the proxy.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
