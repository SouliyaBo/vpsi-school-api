# The front door for the whole system — HTTPS on both names, with certificates
# from Let's Encrypt that Caddy issues and renews on its own.
#
#   vpsischool.com        the admin SPA, from ./admin on the box
#                         (put there by vpsischool-admin/deploy.sh)
#   www.vpsischool.com    redirects to the above
#   api.vpsischool.com    the api container
#
# A certificate is issued only once the GoDaddy A records point at this box and
# the security group lets 80 and 443 in: Let's Encrypt connects back over port 80
# to prove the name is ours. Until then Caddy keeps retrying with a back-off and
# says why in `docker compose ... logs caddy`.
#
# This folder is mounted, not copied, so an edit needs a reload rather than a
# rebuild (deploy.sh does this after every deploy):
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#     exec caddy caddy reload --config /etc/caddy/Caddyfile

vpsischool.com {
	root * /srv/admin
	encode zstd gzip

	# File names under /assets carry a content hash, so a file there never
	# changes and can be cached for good. A name that is not there is a 404 —
	# never index.html, which a browser would then cache for a year as a script.
	handle /assets/* {
		# Only on a file that exists — a 404 cached for a year is worse than none.
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the app. Client-side routes (/students/123, the guardian
	# link /r#token) have no file of their own, so they get index.html, which
	# must be re-checked every time or a new release never reaches anybody.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

www.vpsischool.com {
	redir https://vpsischool.com{uri} permanent
}

api.vpsischool.com {
	encode zstd gzip
	# One hop, which is what `trust proxy: 1` in main.ts expects: request.ip and
	# the throttler see the X-Forwarded-For Caddy adds, not Caddy's own address.
	reverse_proxy api:3000
}
