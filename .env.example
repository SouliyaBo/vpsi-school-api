# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
DEFAULT_LOCALE=lo
LOG_LEVEL=debug

# ── MongoDB ─────────────────────────────────────────────────────────────────
# A replica set is REQUIRED: the app uses multi-document transactions.
# docker-compose starts mongo as a single-node replica set named "rs0".
MONGODB_URI=mongodb://mongo:27017/vpsischool?replicaSet=rs0&directConnection=true

# ── Redis (cache + BullMQ) ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_REFRESH_TTL=7d
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── Object storage (S3-compatible; MinIO in dev) ────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vpsischool
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
S3_SIGNED_URL_TTL_SECONDS=900

# ── HTTP hardening ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ── Exam papers ─────────────────────────────────────────────────────────────
# LibreOffice draws the WMF/EMF equations MathType leaves in a Word file so
# they can be printed. Found automatically in the usual places (the Docker
# image installs it); set this only for an unusual install path.
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
